{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zigsolver-front",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "coordinator",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "../ZigSolverCoordinator",
        "zigsolver-coordinator"
      ],
      "port": 8765
    },
    {
      "name": "mock-hosts",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "mock/server.js",
        "8080",
        "8000"
      ],
      "port": 8080
    },
    {
      "name": "fakebot",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "fakebot/server.js",
        "8081",
        "--hero-delay",
        "8000",
        "--speed",
        "4"
      ],
      "port": 8081
    }
  ]
}
